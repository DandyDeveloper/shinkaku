# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# --- Server ---
PORT=8080
BASE_URL=http://localhost:8080

# --- Database ---
# Path inside the container (mapped to a Docker volume). Override if needed.
DB_PATH=/data/shinkaku.db
# Docker runtime memory available to the backend container.
BACKEND_MEMORY_LIMIT=1g
# Go heap target inside the backend container. Keep this below BACKEND_MEMORY_LIMIT.
BACKEND_GO_MEMORY_LIMIT=768MiB

# --- Ollama ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# AMD ROCm Docker override only: set these to the host device GIDs before using
# docker-compose.amd.yml. Example:
#   VIDEO_GID=$(getent group video | cut -d: -f3)
#   RENDER_GID=$(getent group render | cut -d: -f3)
VIDEO_GID=
RENDER_GID=

# --- Auth (Google OIDC) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set the authorised redirect URI to: ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email address that is allowed to log in (single-user allowlist)
ALLOWED_EMAIL=

# --- Session ---
# Generate with: openssl rand -hex 32
# Must be a 32-byte (64 hex char) value. Sessions will not survive restarts
# if this is left empty — a random value is generated on each startup.
SESSION_SECRET=
